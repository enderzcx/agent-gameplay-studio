# Copy to `.env` (or point TTS_ENV_FILE at it) and fill in YOUR OWN values.
# Nothing here is a real credential, a real endpoint, or a working default.
# The repository ships no key, no endpoint and no quota.

# ---- Speech synthesis (tools/voice/tts_adapter.py) ----
# REQUIRED. Your own endpoint that speaks: POST {base}/chat/completions with an `audio` field.
TTS_BASE_URL=https://your-tts-endpoint.example/v1
# REQUIRED. Sent as `Authorization: Bearer <value>`. Never printed, never written to artifacts.
TTS_API_KEY=replace-me

# Optional. Default model id for the `synth`/`batch` commands.
TTS_MODEL=your-tts-model-id
# Optional. A voice id, or leave EMPTY to not send a voice field at all.
# There is deliberately no default voice: pick one by listening, not by copying ours.
TTS_VOICE=
# Optional. Override the model ids this adapter treats as "design"/"clone" style.
TTS_MODEL_VOICEDESIGN=your-voice-design-model-id
TTS_MODEL_VOICECLONE=your-voice-clone-model-id

# Optional. Read the variables above from a dotenv file instead of the process environment.
# Values are read for these names only, and are never echoed or written into artifacts.
# TTS_ENV_FILE=/abs/path/to/your/.env

# ---- Recording (tools/gamerec/record-game.sh) ----
# REQUIRED for preflight/start. The bundle id of the app whose audio and picture you want.
# There is deliberately NO built-in default; capturing the wrong app silently is worse than failing.
GAME_BUNDLE_ID=com.example.your-app

# ---- EDL assembly (tools/voice/build_sample.sh) ----
# REQUIRED. Source recording. No private default path is baked in.
SRC_VIDEO=/abs/path/to/your/source.mp4
# Optional geometry. Default is scale=960:-2. If your capture has an answer/report panel in frame,
# crop it out HERE — an in-frame answer is a leak, not just a cosmetic problem.
# SRC_CROP=crop=960:966:958:28
# OUT_FPS=30
# TARGET_I=-16
# TARGET_TP=-1.5
